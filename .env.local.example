NEXT_PUBLIC_SUPABASE_URL=https://xhlamwmxhzetdgjobbci.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (sandbox only: the server refuses live keys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PLATFORM_FEE_BPS=0
# Stripe onboarding return URLs and the fallback for Checkout returns (Checkout prefers the buyer's
# origin when it is a known app origin). Local HTTPS dev, the production URL on Vercel, or the public
# URL when self-hosting behind a proxy.
APP_URL=https://localhost:3000
# Unique id for this environment; required when NEXT_PUBLIC_SUPABASE_URL is a local Supabase.
# Letter or digit first, then letters, digits, . _ : - (max 100). Stored as env:<value>. An invalid
# value disables checkout and makes the webhook return 503. Changing it makes open checkouts unrecognised.
# APP_SCOPE=
